{
  "name": "@codeoracle/chunker",
  "version": "0.0.0",
  "private": true,
  "description": "Tree-sitter based chunking engine. Chunks at symbol boundaries (function/class/method), never mid-body. Falls back to sliding-window only when no grammar is available.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codeoracle-chunk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "chunk": "tsx src/cli.ts"
  },
  "dependencies": {
    "@codeoracle/contracts": "workspace:*",
    "tree-sitter": "^0.22.4",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-python": "^0.23.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
