{
  "name": "codeoracle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted MCP server that searches your code and remembers why it's built that way. Free-tier by default.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @codeoracle/db run generate",
    "db:migrate": "pnpm --filter @codeoracle/db run migrate",
    "chunk": "pnpm --filter @codeoracle/chunker run chunk",
    "cli": "pnpm --filter @codeoracle/cli run start"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.5",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.1",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.4.2"
  }
}
