# CodeOracle provider config.
# Copy to providers.yaml.
# chat / embeddings: OpenAI-compatible `/v1/chat/completions` and `/v1/embeddings`.
# rerank (E2.1): Hugging Face TEI `POST /rerank` — not OpenAI-compat (dedicated schema).

chat:
  # Priority order: lower number tried first. On 429/5xx/network error, next enabled
  # endpoint by priority is tried. Provider-specific 4xx (bad key/model) also skips
  # to the next endpoint — it does not retry the same endpoint.

  # Ollama Cloud Free — strong extract quality without Gemini/OpenRouter burn.
  # Create a key at https://ollama.com/settings/keys. Prefer usage level 1–2 models.
  - id: ollama-cloud
    kind: chat
    baseUrl: https://ollama.com/v1
    apiKeyEnv: OLLAMA_API_KEY
    model: gpt-oss:20b-cloud
    priority: 1
    enabled: false # enable once OLLAMA_API_KEY is set

  - id: gemini-free
    kind: chat
    baseUrl: https://generativelanguage.googleapis.com/v1beta/openai
    apiKeyEnv: GEMINI_API_KEY
    model: gemini-2.5-flash
    priority: 10
    enabled: false # enable once GEMINI_API_KEY is set

  - id: groq-free
    kind: chat
    baseUrl: https://api.groq.com/openai/v1
    apiKeyEnv: GROQ_API_KEY
    model: llama-3.3-70b-versatile
    priority: 15
    enabled: false # enable once GROQ_API_KEY is set

  - id: openrouter-free
    kind: chat
    baseUrl: https://openrouter.ai/api/v1
    apiKeyEnv: OPENROUTER_API_KEY
    # Free Models Router — picks an available `:free` model at request time.
    # Or pin a specific free slug, e.g. google/gemma-4-26b-a4b-it:free
    model: openrouter/free
    priority: 20
    enabled: false # enable once OPENROUTER_API_KEY is set

  - id: ollama-local-fallback
    kind: chat
    baseUrl: http://localhost:11434/v1
    apiKeyEnv: null
    model: qwen2.5-coder:1.5b
    priority: 100
    enabled: false # enable for local escape when free-cloud chat hits 429/5xx

embeddings:
  - id: ollama-embed-local
    kind: embeddings
    baseUrl: http://localhost:11434/v1
    apiKeyEnv: null
    model: nomic-embed-text
    priority: 1
    enabled: true

# Optional E2.1 local cross-encoder (TEI). Keep disabled until TEI is running.
# Do not co-locate with a large Ollama chat model on 12GB dogfood hosts (~1–2GB+ TEI).
# Privacy: prefer local TEI — candidate texts include chunk bodies after P0-A refuse.
# Enable path:
#   1. Start TEI with BAAI/bge-reranker-base (see docs/architecture/fused-retrieval.md)
#   2. Set enabled: true below
#   3. SEARCH_RERANK_ENABLED=true and SEARCH_RERANK_TIMEOUT_MS=400–500 for CPU
rerank:
  - id: tei-rerank-local
    protocol: tei
    baseUrl: http://localhost:8080
    apiKeyEnv: null
    # Metadata for usage logs; the TEI container chooses the served weights.
    model: BAAI/bge-reranker-base
    priority: 1
    enabled: false
