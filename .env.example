# CodeOracle — environment template. Copy to .env and fill in.
# Launch defaults match infra/compose (Postgres/Redis/Qdrant on localhost).
# Validated at startup by packages/config — invalid/missing required values fail loudly, never silently default.

NODE_ENV=development

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codeoracle
POSTGRES_USER=codeoracle
POSTGRES_PASSWORD=change-me-in-dev
DATABASE_URL=postgresql://codeoracle:change-me-in-dev@localhost:5432/codeoracle

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- GitHub (Stage 2+) ---
GITHUB_PAT=
# Shared secret for POST /webhooks/github (X-Hub-Signature-256). Required for push webhooks.
GITHUB_WEBHOOK_SECRET=change-me-in-dev

# --- Local paths (Stage 2+) ---
CODEORACLE_CLONE_DIR=./data/clones
PROVIDERS_CONFIG_PATH=./providers.yaml

# --- Provider API keys (only needed for the endpoints you enable in providers.yaml) ---
# See providers.yaml.example for the ₹0 default chain (Ollama local + free cloud chat).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama Cloud (https://ollama.com/settings/keys) — OpenAI-compat at https://ollama.com/v1
OLLAMA_API_KEY=

# --- MCP stdio / HTTP (Stage 4–5) ---
# Repo UUID from `pnpm cli repo register` / `repo status`. Required for mcp-server.
CODEORACLE_REPO_ID=
# stdio (default) | http
CODEORACLE_MCP_TRANSPORT=stdio
# Streamable HTTP listen (when TRANSPORT=http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100
MCP_HTTP_RATE_LIMIT_PER_MINUTE=60
# Optional dedicated MCP HTTP bearer (API_TOKEN or scoped api_tokens also work)
MCP_HTTP_BEARER_TOKEN=

# --- HTTP API (Stage 2) ---
API_PORT=3000
# Optional listen host. Unset = all interfaces (0.0.0.0). Prefer 127.0.0.1 locally.
# API_HOST=127.0.0.1
# Optional — when set, mutating routes require Authorization: Bearer <token>
# Required in NODE_ENV=production when binding a non-loopback host (E6).
API_TOKEN=

# Comma-separated roots for local repo register/index (E6 clone-root jail).
# Required in production when using --local-path / POST localPath.
# Does NOT replace P0-A secret path denylist (.env / .env2 / keys).
# CODEORACLE_ALLOWED_ROOTS=/Users/you/src,/var/repos

# --- Worker tuning (Stage 2.5) ---
WORKER_CONCURRENCY=6
DB_POOL_MAX=5
EMBED_BATCH_SIZE=32
EXTRACT_CONCURRENCY=2
# Drop extracted decisions below this confidence (0.0–1.0). Default 0.5.
EXTRACT_MIN_CONFIDENCE=0.5
# Cap extract jobs after full index (0 = unlimited). Use e.g. 10 for dogfood samples.
EXTRACT_QUEUE_LIMIT=0
# Soft per-repo daily extract token budget (0 = off). Skips LLM calls when exceeded.
EXTRACT_REPO_DAILY_TOKEN_BUDGET=0
JOB_HISTORY_RETENTION_DAYS=30
# Commits retained in each clone so extract can resolve changed files via git.
CLONE_HISTORY_DEPTH=200
CLONE_MAX_REPOS=50
INDEX_RECOVER_ON_STARTUP=true
# E2/E2.1 optional post-fusion rerank (TEI cross-encoder). Default off.
# Enable only with an enabled `rerank:` endpoint in providers.yaml (local TEI).
# When true without endpoints, search keeps fused RRF order (identity).
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_MAX_CANDIDATES=20
# Fail-open timeout (ms). Stock 150 is optimistic; local CPU TEI dogfood: 400–500.
SEARCH_RERANK_TIMEOUT_MS=150
