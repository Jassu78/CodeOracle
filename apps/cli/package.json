{
  "name": "@codeoracle/cli",
  "version": "0.0.0",
  "private": true,
  "description": "CodeOracle TUI bootstrap + ops CLI: doctor, init, status, mcp-config, repo, decisions.",
  "type": "module",
  "bin": {
    "codeoracle": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@codeoracle/config": "workspace:*",
    "@codeoracle/contracts": "workspace:*",
    "@codeoracle/db": "workspace:*",
    "@codeoracle/queue": "workspace:*",
    "@codeoracle/retrieval": "workspace:*",
    "@codeoracle/worker": "workspace:*",
    "@clack/prompts": "^0.9.1",
    "commander": "^13.0.0",
    "drizzle-orm": "^0.45.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
