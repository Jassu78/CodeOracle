{
  "name": "@codeoracle/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ consumers: chunk · embed · extract · reindex.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@codeoracle/chunker": "workspace:*",
    "@codeoracle/config": "workspace:*",
    "@codeoracle/contracts": "workspace:*",
    "@codeoracle/db": "workspace:*",
    "@codeoracle/gateway": "workspace:*",
    "@codeoracle/observability": "workspace:*",
    "@codeoracle/queue": "workspace:*",
    "@codeoracle/retrieval": "workspace:*",
    "@octokit/rest": "^22.0.0",
    "bullmq": "^5.34.8",
    "drizzle-orm": "^0.38.3",
    "ignore": "^7.0.6",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
